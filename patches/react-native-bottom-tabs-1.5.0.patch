+  // Material pads the bar by the window's bottom inset, and with adjustResize that inset includes the keyboard's: the
+  // bar would grow by the keyboard's height and sit on top of it, squeezing the screen above. The keyboard covers the
+  // bar instead (as on iOS), so the bar takes the system bars' insets only.
+  override fun dispatchApplyWindowInsets(insets: WindowInsets): WindowInsets {
+    val compat = WindowInsetsCompat.toWindowInsetsCompat(insets, this)
+    if (!compat.isVisible(WindowInsetsCompat.Type.ime())) return super.dispatchApplyWindowInsets(insets)
+    val withoutKeyboard = WindowInsetsCompat.Builder(compat)
+      .setInsets(WindowInsetsCompat.Type.ime(), Insets.NONE)
+      .setVisible(WindowInsetsCompat.Type.ime(), false)
+      .build()
+    super.dispatchApplyWindowInsets(withoutKeyboard.toWindowInsets() ?: insets)
+    return insets
+  }
