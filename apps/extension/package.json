{
  "name": "@emberhut/extension",
  "version": "0.1.0",
  "private": true,
  "description": "The Emberhut browser extension: Emberhut's hands in the owner's own Chrome profiles (Manifest V3)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "zip": "node scripts/zip.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test && pnpm run build && pnpm run zip"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.8",
    "@types/node": "~22.18.13",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7"
  }
}
