{
  "manifest_version": 3,
  "name": "Emberhut",
  "version": "0.1.0",
  "description": "Lets Emberhut work in this Chrome profile, only in its own tabs; Pause lets it go for 10 minutes, then it comes back by itself.",
  "minimum_chrome_version": "125",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Emberhut",
    "default_icon": {
      "16": "icons/emberhut-16.png",
      "32": "icons/emberhut-32.png"
    }
  },
  "icons": {
    "16": "icons/emberhut-16.png",
    "48": "icons/emberhut-48.png",
    "128": "icons/emberhut-128.png"
  },
  "permissions": ["debugger", "tabs", "tabGroups", "webNavigation", "storage", "alarms", "notifications", "identity", "identity.email"]
}
