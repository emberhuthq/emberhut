# Copy to .env (git-ignored; this example has no dot so no .env file is ever tracked). Expo loads it for app.config.ts, `expo start` and `expo prebuild`.
# The server isn't configured here: the app asks for its address when it pairs.

# Firebase's Android config for FCM push (package com.emberhut.mobile). Leave unset to build without push.
GOOGLE_SERVICES_FILE=/path/to/google-services.json

# The Apple developer team that signs the iOS app (its 10-character Team ID). Leave unset and Xcode asks for one.
APPLE_TEAM_ID=ABCDE12345

# Read by Gradle when it builds a release: a properties file with storeFile, storePassword, keyAlias and keyPassword.
# Leave unset and release builds are signed with the debug key.
EMBERHUT_ANDROID_KEYSTORE_PROPERTIES=/path/to/emberhut-android-keystore.properties

# The emberhut.com account (sign in, and the list of your machines). Official builds set both; builds from source and
# self-hosters leave both empty, and the app then has no account at all. Setting only one stops the build.
# Clerk's publishable key (public by design, but it never goes into the repo):
EXPO_PUBLIC_EMBERHUT_CLERK_PUBLISHABLE_KEY=
# The directory's https origin, https://<relay domain> (its API is under /v1):
EXPO_PUBLIC_EMBERHUT_DIRECTORY_URL=
# 1 to offer sign-in with a passkey too: it needs Clerk's paid plan and the app's associated domain. Off when empty.
EXPO_PUBLIC_EMBERHUT_PASSKEYS=

# A wire dialect, for building the app for a server that spells some wire words differently: its JSON on one line, e.g.
# {"words":[["person","owner"]],"prefixes":[["K-","T-"]]} (README.md, "Building the app for a server that spells some wire
# words differently"). Empty: the app's own words, nothing rewritten.
EXPO_PUBLIC_EMBERHUT_WIRE_DIALECT=
