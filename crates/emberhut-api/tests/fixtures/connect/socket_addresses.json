    },
    {
      "input": "[::ffff:192.0.2.1]:18990",
      "normal": "192.0.2.1:18990"
    },
    {
      "input": "[2001:0DB8:0000::0001]:18990",
      "normal": "[2001:db8::1]:18990"
    },
    {
      "input": "[2001:db8:0:0:1:0:0:1]:80",
      "normal": "[2001:db8::1:0:0:1]:80"
    },
    {
      "input": "[::1]:18990",
      "normal": "[::1]:18990"
    }
  ],
  "parse": [
