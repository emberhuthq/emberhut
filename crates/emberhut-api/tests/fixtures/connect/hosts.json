    {
      "input": "[2001:0DB8:0:0::1]:443",
      "scheme": "https",
      "normal": "[2001:db8::1]"
    },
    {
      "input": "[2001:db8:0:0:1:0:0:1]:18990",
      "scheme": "http",
      "normal": "[2001:db8::1:0:0:1]:18990"
    },
    {
      "input": "[2001:db8:0:1:1:1:1:1]",
      "scheme": "http",
      "normal": "[2001:db8:0:1:1:1:1:1]"
    },
    {
      "input": "[::1]:18990",
      "scheme": "http",
      "normal": "[::1]:18990"
    },
    {
      "input": "3j6rajbbrd2yrrvdkoq2mouz5aqxwh5c.relay.example",
